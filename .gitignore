# Generated by xcodegen from project.yml. Never commit it: it is a build
# artifact, and a committed copy goes stale the moment a file is added.
*.xcodeproj
*.xcworkspace
GlowWidget/Info.plist
Glow/Info.plist
# Generated by xcodegen from the entitlements properties in project.yml.
Glow/Glow.entitlements
GlowWidget/GlowWidget.entitlements

# Test-run evidence: result bundles, logs, attachments and the structured
# verdict, one directory per run. Kept because a failing run's bundle is the
# most valuable thing it produces, and never committed.
Artifacts/

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
.DS_Store

# The pinned XcodeGen, downloaded and digest-checked on first use by
# Tools/install-xcodegen.sh. The pin is committed; the 14MB binary is not.
Tools/.xcodegen/

# Machine-local values (signing team, device UDIDs). Never committed: a team ID
# is an account identifier, not a project fact.
Tools/local.env
Local.xcconfig

# Scratch space for drafts and notes that are worth keeping but not shipping.
private/

# Claude Code, per-machine. Permission grants are a property of this
# checkout and this operator, not of the project.
.claude/settings.local.json

# Agent worktrees. `git worktree add` puts a whole second checkout here, and
# an untracked nested checkout is one `git add -A` away from being committed
# into the repository it is a copy of.
.claude/worktrees/
